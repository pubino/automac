# Copy to .env (gitignored) and edit. Read by examples/zsh/tartvm and examples/python/tartvm.

# Absolute path to a pinned, verified tart binary (not whatever is first on PATH).
TARTVM_TART=/Users/OPERATOR/tartvm-state/tools/tart-2.41.1/tart.app/Contents/MacOS/tart
# Project-private state: Tart VMs ($TARTVM_HOME/tart), VM-only SSH key, logs. Outside the repo.
TARTVM_HOME=/Users/OPERATOR/tartvm-state

# Optional
TARTVM_PREFIX=tartvm
TARTVM_IMAGE=tartvm-image-base
TARTVM_USER=tester
TARTVM_CPUS=4
TARTVM_MEMORY_GB=8
TARTVM_BOOT_TIMEOUT=600
TARTVM_SHUTDOWN_TIMEOUT=600
