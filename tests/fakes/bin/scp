#!/usr/bin/env python3
"""Fake scp: uploads land in $FAKE_STATE/guest/ with the remote path flattened."""

import os
import shutil
import sys
from pathlib import Path

state = Path(os.environ["FAKE_STATE"])
src, dst = sys.argv[-2], sys.argv[-1]
assert "@" in dst, "only uploads are used by tartvm"
remote = dst.split(":", 1)[1]
(state / "guest").mkdir(exist_ok=True)
shutil.copyfile(src, state / "guest" / remote.strip("/").replace("/", "_"))
