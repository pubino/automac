#!/usr/bin/env python3
"""Fake curl: serves $FAKE_DOWNLOADS/<basename of URL>; logs each call."""
import os, shutil, sys
from pathlib import Path
args = sys.argv[1:]
with open(os.environ["FAKE_LOG"], "a") as fh:
    fh.write("curl " + " ".join(args) + "\n")
if os.environ.get("FAKE_CURL_FAIL"):
    print("curl: (6) Could not resolve host", file=sys.stderr); sys.exit(6)
out, url = args[args.index("-o") + 1], args[-1]
assert url.startswith("https://"), url
assert "--proto" in args and args[args.index("--proto") + 1] == "=https"
src = Path(os.environ["FAKE_DOWNLOADS"]) / url.rsplit("/", 1)[-1]
if not src.exists():
    print("curl: (22) 404", file=sys.stderr); sys.exit(22)
shutil.copyfile(src, out)
